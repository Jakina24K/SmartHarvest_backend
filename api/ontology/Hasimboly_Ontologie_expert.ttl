@prefix : <http://www.semanticweb.org/tsanta/ontologies/2026/4/untitled-ontology-12/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/tsanta/ontologies/2026/4/untitled-ontology-12/> .

<http://www.hasimboly.mg/ontologies/agri> rdf:type owl:Ontology .

#################################################################
#    OBJECT PROPERTIES
#################################################################

:aPourClimat rdf:type owl:ObjectProperty ;
    rdfs:domain :Region ;
    rdfs:range :Climat .

:aPourTypeDeSol rdf:type owl:ObjectProperty ;
    rdfs:domain :Region ;
    rdfs:range :Sol .

:affecte rdf:type owl:ObjectProperty ;
    rdfs:domain :Maladie ;
    rdfs:range :Culture .

:estAdapteeA rdf:type owl:ObjectProperty ;
    rdfs:domain :Culture ;
    rdfs:range :Sol .

:estLocaliseeDans rdf:type owl:ObjectProperty ;
    rdfs:domain :Culture ;
    rdfs:range :Region .

:necessite rdf:type owl:ObjectProperty ;
    rdfs:domain :Culture ;
    rdfs:range :Intrant .

:seCultiveDurant rdf:type owl:ObjectProperty ;
    rdfs:domain :Culture ;
    rdfs:range :Saison .

#################################################################
#    CLASSES
#################################################################

:Climat rdf:type owl:Class .
:Culture rdf:type owl:Class .
:Intrant rdf:type owl:Class .
:Maladie rdf:type owl:Class .
:Region rdf:type owl:Class .
:Saison rdf:type owl:Class .
:Sol rdf:type owl:Class .

#################################################################
#    REGIONS
#################################################################

:analamanga rdf:type :Region ;
    :aPourClimat :toetrandro_an_tampon_tany ;
    :aPourTypeDeSol :tany_mena, :tany_horaka .

:vakinankaratra rdf:type :Region ;
    :aPourClimat :mangatsiaka_be ;
    :aPourTypeDeSol :tany_volkanika, :tany_mena .

:itasy rdf:type :Region ;
    :aPourClimat :toetrandro_tsara ;
    :aPourTypeDeSol :tany_volkanika .

:bongolava rdf:type :Region ;
    :aPourClimat :toetrandro_antonony ;
    :aPourTypeDeSol :tany_mena .

:diana rdf:type :Region ;
    :aPourClimat :mafana ;
    :aPourTypeDeSol :tany_volkanika, :tany_dilatra .

:sava rdf:type :Region ;
    :aPourClimat :mafana_sy_mando ;
    :aPourTypeDeSol :tany_lonaka, :tany_fasika .

:amoron_i_mania rdf:type :Region ;
    :aPourClimat :mangatsiaka ;
    :aPourTypeDeSol :tany_mena .

:matsiatra_ambony rdf:type :Region ;
    :aPourClimat :mangatsiaka ;
    :aPourTypeDeSol :tany_mena .

:vatovavy rdf:type :Region ;
    :aPourClimat :mafana_sy_mando ;
    :aPourTypeDeSol :tany_lonaka .

:fitovinany rdf:type :Region ;
    :aPourClimat :mafana_sy_mando ;
    :aPourTypeDeSol :tany_lonaka .

:ihorombe rdf:type :Region ;
    :aPourClimat :maina_sy_rivotra ;
    :aPourTypeDeSol :tany_mena .

:atsimo_atsinanana rdf:type :Region ;
    :aPourClimat :mafana_sy_mando ;
    :aPourTypeDeSol :tany_lonaka .

:boeny rdf:type :Region ;
    :aPourClimat :mafana_sy_maina ;
    :aPourTypeDeSol :tany_dilatra .

:sofia rdf:type :Region ;
    :aPourClimat :mafana ;
    :aPourTypeDeSol :tany_dilatra .

:betsiboka rdf:type :Region ;
    :aPourClimat :mafana ;
    :aPourTypeDeSol :tany_mena .

:melaky rdf:type :Region ;
    :aPourClimat :mafana ;
    :aPourTypeDeSol :tany_fasika .

:alaotra_mangoro rdf:type :Region ;
    :aPourClimat :mafana_sy_mando ;
    :aPourTypeDeSol :tany_dilatra .

:atsinanana rdf:type :Region ;
    :aPourClimat :mafana_sy_be_orana ;
    :aPourTypeDeSol :tany_lonaka .

:analanjirofo rdf:type :Region ;
    :aPourClimat :mafana_be_sy_mando ;
    :aPourTypeDeSol :tany_lonaka .

:atsimo_andrefana rdf:type :Region ;
    :aPourClimat :maina_sy_mafana ;
    :aPourTypeDeSol :tany_fasika, :tany_sokay .

:androy rdf:type :Region ;
    :aPourClimat :karankaina ;
    :aPourTypeDeSol :tany_sokay, :tany_fasika .

:anosy rdf:type :Region ;
    :aPourClimat :somary_maina ;
    :aPourTypeDeSol :tany_fasika .

:menabe rdf:type :Region ;
    :aPourClimat :mafana_sy_maina ;
    :aPourTypeDeSol :tany_dilatra .

#################################################################
#    CULTURES
#################################################################

:vary rdf:type :Culture ;
    :estLocaliseeDans :analamanga, :vakinankaratra, :alaotra_mangoro .

:katsaka rdf:type :Culture ;
    :estLocaliseeDans :bongolava, :menabe, :vakinankaratra .

:ovy rdf:type :Culture ;
    :estLocaliseeDans :vakinankaratra, :amoron_i_mania .

:mangahazo rdf:type :Culture ;
    :estLocaliseeDans :androy, :atsimo_andrefana .

:lavanila rdf:type :Culture ;
    :estLocaliseeDans :sava, :analanjirofo .

:kafe rdf:type :Culture ;
    :estLocaliseeDans :vatovavy, :fitovinany .

:jirofo rdf:type :Culture ;
    :estLocaliseeDans :analanjirofo, :sava .

:kakao rdf:type :Culture ;
    :estLocaliseeDans :diana, :sava .

:voatabia rdf:type :Culture ;
    :estLocaliseeDans :analamanga, :itasy .

:akondro rdf:type :Culture ;
    :estLocaliseeDans :vatovavy, :fitovinany .

:manga rdf:type :Culture ;
    :estLocaliseeDans :boeny, :sofia .

:voanio rdf:type :Culture ;
    :estLocaliseeDans :sava, :diana .

:fary rdf:type :Culture ;
    :estLocaliseeDans :diana, :boeny .

:landihazo rdf:type :Culture ;
    :estLocaliseeDans :atsimo_andrefana, :menabe .

:litchi rdf:type :Culture ;
    :estLocaliseeDans :atsinanana, :analanjirofo .

#################################################################
#    MALADIES
#################################################################

:pyriculariose rdf:type :Maladie ;
    :affecte :vary .

:helminthosporiose rdf:type :Maladie ;
    :affecte :vary .

:bacteriose_du_riz rdf:type :Maladie ;
    :affecte :vary .

:trimena rdf:type :Maladie ;
    :affecte :vary .

:fusariose_lavanila rdf:type :Maladie ;
    :affecte :lavanila .

:anthracnose_lavanila rdf:type :Maladie ;
    :affecte :lavanila .

:pourriture_des_racines rdf:type :Maladie ;
    :affecte :lavanila, :kakao .

#################################################################
#    SOLS
#################################################################

:tany_mena rdf:type :Sol .
:tany_horaka rdf:type :Sol .
:tany_volkanika rdf:type :Sol .
:tany_dilatra rdf:type :Sol .
:tany_lonaka rdf:type :Sol .
:tany_fasika rdf:type :Sol .
:tany_sokay rdf:type :Sol .

#################################################################
#    CLIMATS
#################################################################

:toetrandro_an_tampon_tany rdf:type :Climat .
:mangatsiaka_be rdf:type :Climat .
:mafana_sy_mando rdf:type :Climat .
:karankaina rdf:type :Climat .
:mafana_sy_maina rdf:type :Climat .
:maina_sy_mafana rdf:type :Climat .
:toetrandro_tsara rdf:type :Climat .
:toetrandro_antonony rdf:type :Climat .
:mangatsiaka rdf:type :Climat .
:maina_sy_rivotra rdf:type :Climat .
:mafana_sy_be_orana rdf:type :Climat .
:mafana_be_sy_mando rdf:type :Climat .
:somary_maina rdf:type :Climat .
:mafana rdf:type :Climat .

#################################################################
#    SAISONS
#################################################################

:novambra_aprily rdf:type :Saison .
:jona_aogositra rdf:type :Saison .
:mandavantaona rdf:type :Saison .

#################################################################
#    INTRANTS
#################################################################

:npk rdf:type :Intrant .
:uree rdf:type :Intrant .
:sokay rdf:type :Intrant .
:zezika_omby rdf:type :Intrant .
:zezika_kianja rdf:type :Intrant .
:komposta rdf:type :Intrant .