#################################################################
#    INDIVIDUALS - MALADIES ET IMPACTS DÉTAILLÉS
#################################################################

# --- Maladies du Riz (Vary) ---
:Pyriculariose rdf:type :Maladie ; :affecte :Vary .
:Helminthosporiose rdf:type :Maladie ; :affecte :Vary .
:Bactériose_du_riz rdf:type :Maladie ; :affecte :Vary .
:Trimena rdf:type :Maladie ; :affecte :Vary .

# --- Maladies de la Vanille (Lavanila) ---
:Fusariose_lavanila rdf:type :Maladie ; :affecte :Lavanila .
:Anthracnose_lavanila rdf:type :Maladie ; :affecte :Lavanila .
:Pourriture_des_racines rdf:type :Maladie ; :affecte :Lavanila, :Kakao .

# --- Maladies du Maïs (Katsaka) ---
:Chenille_Legionnaire rdf:type :Maladie ; :affecte :Katsaka .
:Harafesina_katsaka rdf:type :Maladie ; :affecte :Katsaka .
:Striga_boka rdf:type :Maladie ; :affecte :Katsaka, :Vary .

# --- Maladies de la Pomme de terre et Maraîchage (Ovy, Voatabia) ---
:Mildiou rdf:type :Maladie ; :affecte :Ovy, :Voatabia .
:Flétrissement_bactérien rdf:type :Maladie ; :affecte :Ovy, :Voatabia, :Akondro .
:Gale_commune rdf:type :Maladie ; :affecte :Ovy .

# --- Maladies du Manioc (Mangahazo) ---
:Mosaïque_mangahazo rdf:type :Maladie ; :affecte :Mangahazo .
:Striure_brune_mangahazo rdf:type :Maladie ; :affecte :Mangahazo .
:Soka_mangahazo rdf:type :Maladie ; :affecte :Mangahazo .

# --- Maladies du Café (Kafe) ---
:Harafesina_kafe rdf:type :Maladie ; :affecte :Kafe .
:Scolyte_du_café rdf:type :Maladie ; :affecte :Kafe .

# --- Maladies du Girofle (Jirofo) ---
:Mort_subite_jirofo rdf:type :Maladie ; :affecte :Jirofo .
:Cylindrocladium rdf:type :Maladie ; :affecte :Jirofo .

# --- Maladies des Fruits (Manga, Litchi, Akondro) ---
:Mouche_des_fruits rdf:type :Maladie ; :affecte :Manga, :Litchi, :Kakao .
:Cochenille_farineuse rdf:type :Maladie ; :affecte :Voanio, :Manga, :Lavanila .
:Maladie_de_Panama rdf:type :Maladie ; :affecte :Akondro .
:Sigatoka_mainty rdf:type :Maladie ; :affecte :Akondro .

# --- Ravageurs Généraux ---
:Valala_mpifindra rdf:type :Maladie ; :affecte :Vary, :Katsaka, :Fary, :Landihazo .
:Voalavo_saha rdf:type :Maladie ; :affecte :Vary, :Voanio, :Kakao .

