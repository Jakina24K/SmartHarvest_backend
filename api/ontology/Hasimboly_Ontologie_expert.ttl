#################################################################
#    INDIVIDUALS - CULTURES
#################################################################

:Vary rdf:type :Culture ; :estLocaliséeDans :ANALAMANGA, :VAKINANKARATRA, :ALAOTRA_MANGORO, :ITASY, :SOFIA, :BOENY, :DIANA, :SAVA, :ANALANJIROFO, :ATSINANANA, :VATOVAVY, :FITOVINANY, :ATSIMO_ATSINANANA, :MATSIATRA_AMBONY, :AMORON_I_MANIA, :BETSIBOKA, :BONGOLAVA, :MELAKY, :MENABE, :ATSIMO_ANDREFANA, :ANOSY, :IHOROMBE .
