@prefix : <http://www.semanticweb.org/tsanta/ontologies/2026/4/untitled-ontology-12/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/tsanta/ontologies/2026/4/untitled-ontology-12/> .

<http://www.hasimboly.mg/ontologies/agri> rdf:type owl:Ontology .

#################################################################
#    Object Properties
#################################################################

:aPourClimat rdf:type owl:ObjectProperty ; rdfs:domain :Region ; rdfs:range :Climat .
:aPourTypeDeSol rdf:type owl:ObjectProperty ; rdfs:domain :Region ; rdfs:range :Sol .
:affecte rdf:type owl:ObjectProperty ; rdfs:domain :Maladie ; rdfs:range :Culture .
:estAdaptéeÀ rdf:type owl:ObjectProperty ; rdfs:domain :Culture ; rdfs:range :Sol .
:estLocaliséeDans rdf:type owl:ObjectProperty ; rdfs:domain :Culture ; rdfs:range :Region .
:nécessite rdf:type owl:ObjectProperty ; rdfs:domain :Culture ; rdfs:range :Intrant .
:seCultiveDurant rdf:type owl:ObjectProperty ; rdfs:domain :Culture ; rdfs:range :Saison .

#################################################################
#    Classes
#################################################################

:Climat rdf:type owl:Class .
:Culture rdf:type owl:Class .
:Intrant rdf:type owl:Class .
:Maladie rdf:type owl:Class .
:Region rdf:type owl:Class .
:Saison rdf:type owl:Class .
:Sol rdf:type owl:Class .

#################################################################
